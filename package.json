{
  "name": "dsh-token-status",
  "version": "1.1.0",
  "description": "Token spend by peak and off-peak tariff, prompt-cache hit and cost per model (deepseek-flash, deepseek-v4-pro) in the DeepSeek Harness Web GUI bottom status bar, with a peak-hour indicator, an English/Russian interface and one-click price autofill",
  "type": "module",
  "license": "MIT",
  "author": "Nosferatus83",
  "homepage": "https://github.com/Nosferatus83/DSH-token-status#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nosferatus83/DSH-token-status.git"
  },
  "bugs": {
    "url": "https://github.com/Nosferatus83/DSH-token-status/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "status-bar",
    "tokens",
    "cost",
    "tariff"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "pricing.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
